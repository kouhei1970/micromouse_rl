__pycache__/
*.pyc
.venv/
.DS_Store
MUJOCO_LOG.TXT

# Generated artifacts
logs/
models/*.zip

# outputs/ は原則として版管理しない（動画・図・中間生成物は再生成できる）。
# ただし各実験の latest/metrics.json だけは追跡する。
# 理由: 結論の根拠となる「走行ごとの指標」がここにしか無く、版管理外だと
# この機械が変わった時点で全実験の検算可能性が失われる（研究計画書 §9-3）。
# git は無視されたディレクトリの中を走査しないので、ディレクトリは再包含する必要がある。
outputs/**
!outputs/**/
!outputs/**/latest/metrics.json

# exp_013 の走行ごと記録は **M4/M5 gate の基準値そのものの出所** なので追跡する
# （指示 2026-08-13-P6。准教授 AUDIT_008 続報 A-3 の指摘を採用）。
# 理由: §5 の凍結表の値はこの JSON からしか復元できない。版管理外のままだと、
# 2026-08-13 に 3 条件を削除・再実行したのと同じことが l0c に起きた時点で、
# 基準値の追跡可能性が消える。**再実行で同じ値が出ること（決定性）は確認済みだが、
# 「同じ値が出る」ことと「当時の値が残っている」ことは別である。**
# traj/*.npz は除外のまま（1 面あたり数 MB。決定的に再生成できる）。
# l0c_determinism_check も含める: l0c だけ別日・別プロセスの産物であり、これを他 3 条件と
# 混ぜて 1 つの基準値にしてよい根拠が、この照合そのものだから（100 走行・全フィールド一致）。
!outputs/exp_013_band_v4_reeval/*/runs_detail.json
# 016-H1e（第三容疑・否定対照つき）: 判定 q が乗っている値そのもの。全 12 本で 528 KB と
# 軽量なうえ、決定性は実測済み（健常の再走行が保存済み一次記録と 6 水準すべて完全一致）。
# §9-21 (a) の「走行ごとの要約は版管理する」に従って含める。
!outputs/exp_016_diagonal/016h1e/*.json
# exp_021（観測履歴の連結）: 判定が乗っている値そのもの（summary/metrics/p5）だけの
# 軽量版は版管理下に置く（各 60 KB 程度）。毎歩の生データ入りの完全版（7 MB 超）は
# 置かず、SHA-256 を experiments/exp_021_observation_history/card.md に記録する。
# 准教授 AUDIT_042 §3 の (2)(3)・2026-08-14 採択。生成は同ディレクトリの slim_output.py
!outputs/exp_021_driving_*.slim.json
# exp_022（にせ履歴）も同じ扱い（判定が乗っている値だけの軽量版を版管理下へ）
!outputs/exp_022_driving_*.slim.json
!outputs/exp_022_judgment.json
# 016-H1（遷移域の横偏差低減）の実装前診断 D1・D2。予測 H4 の判定が乗っている値であり、
# 軽量（数十 KB）なので版管理下へ。生成は experiments/exp_016_diagonal/run_016h1_diag.py
!outputs/exp_016_diagonal/016h1/*.json

# legacy/models/ の学習済みチェックポイントは凍結成果物として追跡する
# Checkpoints under legacy/models/ are frozen artifacts and must remain tracked
!legacy/models/*.zip

# exp_012 条件 E の「ゴールに届いた唯一の重み」を追跡する（指示 2026-08-13）。
# 出所: logs/exp_012_condE_seed2/rl_model_2000000_steps.zip（200 万歩ちょうどの
# チェックポイント）。**本実験で唯一生き残った陽性の重み**である —
# 最終保存 models/exp_012_condE_seed2.zip は 896 歩の追加学習で「7017 に届く状態」から
# 離脱しており（同じ面で 42 歩・衝突）、seed1 の陽性 3 点は重みが残っていない。
# 機構分析の唯一の材料なので、logs/ が版管理外であることによる消失を防ぐ。
# 489,543 バイト・一度きり（准教授 AUDIT_018 §3-bis・研究計画書 §9-19）。
!models/exp_012_condE_seed2_step2000000_goal7017.zip
# 発表用動画（2026-08-19）: 完成物と、その素材である走行動画。
# 再生成は research_notes/scripts/make_story_video.py（走行動画は render 経由）。
# 9 MB と 13 MB で軽量なため、成果物として版管理下に置く。
!outputs/video_rebuild/*.mp4
